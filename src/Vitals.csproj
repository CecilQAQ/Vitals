<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Vitals</AssemblyName>
    <RootNamespace>Vitals</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <Version>1.0.3</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <Product>Vitals</Product>
    <AssemblyTitle>Vitals 硬件监测</AssemblyTitle>
    <NoWarn>$(NoWarn);CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="IntelMSR.bin" LogicalName="Vitals.IntelMSR.bin" />
    <EmbeddedResource Include="app.ico" LogicalName="Vitals.app.ico" />
    <EmbeddedResource Include="..\tools\PresentMon.exe" LogicalName="Vitals.PresentMon.exe" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- PresentMon 不进仓库（见 tools/README.md），但缺了它打出来的 exe 就没有帧率。
       以前靠 Condition 静默跳过，能编译通过、只是包小了 1 MB，帧率永远显示占位符，很难发现。
       现在直接报错。 -->
  <Target Name="CheckPresentMon" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)..\tools\PresentMon.exe')"
           Text="缺少 tools\PresentMon.exe：请按 tools/README.md 下载 PresentMon v2.6.0，重命名为 PresentMon.exe 放到 tools\ 下再编译。" />
  </Target>

</Project>
